merkblatt/.build-*.html

# OS / Editor / Python
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
__pycache__/

# Secrets / lokale Konfig — NIEMALS committen
.env
*.key
*.pem

# --- Lizenzpflichtige Assets ---------------------------------------------
